<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.input.KeyCombination?>
<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0"
           prefWidth="1280.0" stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.medac.gymfit.interfacestarea67gymfit.MainController">
    <children>
        <BorderPane prefHeight="200.0" prefWidth="200.0">
            <top>
                <VBox prefWidth="100.0" BorderPane.alignment="CENTER">
                    <children>
                        <MenuBar>
                            <menus>
                                <Menu mnemonicParsing="false" text="Archivo">
                                    <items>
                                        <MenuItem mnemonicParsing="false" onAction="#salir" text="Salir">
                                            <accelerator>
                                                <KeyCombination fx:value="Ctrl+Q"/>
                                            </accelerator>
                                        </MenuItem>
                                    </items>
                                </Menu>
                                <Menu mnemonicParsing="false" text="Editar">
                                    <items>
                                        <MenuItem mnemonicParsing="false" onAction="#borrar" text="Borrar socio">
                                            <accelerator>
                                                <KeyCombination fx:value="Ctrl+D"/>
                                            </accelerator>
                                        </MenuItem>
                                    </items>
                                </Menu>
                                <Menu mnemonicParsing="false" text="Ayuda">
                                    <items>
                                        <MenuItem mnemonicParsing="false" onAction="#acercaDe" text="Acerca de GymFit">
                                            <accelerator>
                                                <KeyCombination fx:value="F1"/>
                                            </accelerator>
                                        </MenuItem>
                                    </items>
                                </Menu>
                            </menus>
                        </MenuBar>
                        <ToolBar prefHeight="40.0" prefWidth="200.0">
                            <items>
                                <Button mnemonicParsing="false" onAction="#nuevo" text="📄 Nuevo">
                                    <tooltip><Tooltip text="Limpia el formulario para crear un socio desde cero"/></tooltip>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#guardar" text="💾 Guardar">
                                    <tooltip><Tooltip text="Guarda los datos del socio actual"/></tooltip>
                                </Button>
                                <Button layoutX="88.0" layoutY="10.0" mnemonicParsing="false" onAction="#simularError" text="⚠️ Simular Error">
                                    <tooltip><Tooltip text="Lanza una prueba de la ventana de error"/></tooltip>
                                </Button>
                            </items>
                        </ToolBar>
                    </children>
                </VBox>
            </top>
            <center>
                <HBox prefHeight="100.0" prefWidth="200.0" spacing="30.0" BorderPane.alignment="CENTER">
                    <BorderPane.margin>
                        <Insets/>
                    </BorderPane.margin>
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                    </padding>
                    <children>
                        <VBox prefHeight="200.0" prefWidth="480.0">
                            <children>
                                <Label styleClass="titulo-seccion" text="Alta de socio nuevo">
                                    <VBox.margin>
                                        <Insets bottom="20.0"/>
                                    </VBox.margin>
                                </Label>
                                <GridPane alignment="CENTER_LEFT" hgap="15.0" vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                    </rowConstraints>
                                    <children>
                                        <Label text="Nombre"/>
                                        <TextField fx:id="nombreField" promptText="Ej. David" GridPane.columnIndex="1"/>
                                        <Label layoutX="10.0" layoutY="17.0" text="Apellidos" GridPane.rowIndex="1"/>
                                        <TextField fx:id="apellidosField" layoutX="10.0" layoutY="13.0"
                                                   promptText="Ej. Alonso Aguilar" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1"/>
                                        <Label layoutX="10.0" layoutY="17.0" text="Fecha de nacimiento"
                                               GridPane.rowIndex="2"/>
                                        <DatePicker fx:id="nacimientoField" GridPane.columnIndex="1"
                                                    GridPane.rowIndex="2"/>
                                        <Label text="Sexo" GridPane.rowIndex="3"/>
                                        <HBox fx:id="sexoBox" prefHeight="100.0" prefWidth="200.0" spacing="15.0"
                                              GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <children>
                                                <RadioButton mnemonicParsing="false" text="Hombre"/>
                                                <RadioButton mnemonicParsing="false" text="Mujer"/>
                                                <RadioButton mnemonicParsing="false" text="Otro"/>
                                            </children>
                                        </HBox>
                                        <Label text="Provincia" GridPane.rowIndex="4"/>
                                        <ComboBox id="cmbProvincia" fx:id="provinciaCombo" prefWidth="150.0"
                                                  promptText="Seleccione una provincia" GridPane.columnIndex="1"
                                                  GridPane.rowIndex="4"/>
                                        <Label text="Cuota" GridPane.rowIndex="5"/>
                                        <FlowPane fx:id="cuotaPane" hgap="15.0" prefHeight="200.0" prefWidth="200.0"
                                                  vgap="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                            <children>
                                                <RadioButton mnemonicParsing="false" text="Básica"/>
                                                <RadioButton layoutX="10.0" layoutY="10.0" mnemonicParsing="false"
                                                             text="Plus"/>
                                                <RadioButton layoutX="97.0" layoutY="10.0" mnemonicParsing="false"
                                                             text="Premium"/>
                                                <RadioButton layoutX="10.0" layoutY="27.0" mnemonicParsing="false"
                                                             text="Joven"/>
                                                <RadioButton layoutX="97.0" layoutY="27.0" mnemonicParsing="false"
                                                             text="Senior"/>
                                            </children>
                                        </FlowPane>
                                        <Label text="Clases" GridPane.rowIndex="6"/>
                                        <ComboBox id="cmbClases" fx:id="clasesCombo" prefWidth="150.0"
                                                  promptText="Seleccione una clase" GridPane.columnIndex="1"
                                                  GridPane.rowIndex="6"/>
                                        <Label text="IBAN" GridPane.rowIndex="7"/>
                                        <TextField fx:id="ibanField" promptText="ESXX XXXX XXXX..."
                                                   GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                                    </children>
                                </GridPane>
                                <HBox alignment="BOTTOM_CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
                                    <children>
                                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#nuevo"
                                                styleClass="btn-peligro-borde" text="Limpiar datos"/>
                                        <Button minWidth="120.0" mnemonicParsing="false" onAction="#borrar"
                                                prefWidth="120.0" styleClass="btn-peligro-borde" text="Borrar socio"/>
                                        <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS"/>
                                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#cancelar"
                                                styleClass="btn-secundario" text="Cancelar"/>
                                        <Button fx:id="guardarButton" layoutX="383.0" layoutY="85.0"
                                                minWidth="-Infinity" mnemonicParsing="false" onAction="#guardar"
                                                styleClass="btn-primario" text="Guardar socio"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="titulo-seccion" text="Listado de socios registrados">
                                    <VBox.margin>
                                        <Insets bottom="20.0"/>
                                    </VBox.margin>
                                </Label>
                                <TableView fx:id="tabla" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="columnaNombre" prefWidth="120.0" text="Nombre"/>
                                        <TableColumn fx:id="columnaApellidos" prefWidth="150.0" text="Apellidos"/>
                                        <TableColumn fx:id="columnaNacimiento" prefWidth="150.0"
                                                     text="Fecha Nacimiento"/>
                                        <TableColumn fx:id="columnaCuota" prefWidth="90.0" text="Cuota"/>
                                        <TableColumn fx:id="columnaProvincia" prefWidth="110.0" text="Provincia"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </center>
        </BorderPane>
        <StackPane fx:id="capaOscura" prefHeight="150.0" prefWidth="200.0" visible="false">
            <children>
                <VBox maxHeight="200.0" maxWidth="450.0" prefHeight="200.0" prefWidth="100.0" spacing="15.0"
                      styleClass="dialogo-error">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                    </padding>
                    <children>
                        <Label fx:id="modalTitulo" text="Error en el formato del IBAN">
                            <font>
                                <Font name="System Bold" size="18.0"/>
                            </font>
                        </Label>
                        <Label fx:id="modalTexto"
                               text="El número de cuenta introducido no es válido. Asegúrate de escribir los 24 caracteres sin espacios y comenzando por 'ES'."
                               wrapText="true"/>
                        <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#descartarError" styleClass="btn-secundario"
                                        text="Descartar cambios"/>
                                <Button layoutX="358.0" layoutY="36.0" mnemonicParsing="false" onAction="#ocultarError"
                                        styleClass="btn-primario" text="Corregir datos"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</StackPane>
